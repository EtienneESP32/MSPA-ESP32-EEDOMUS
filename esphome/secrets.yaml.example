# Copier ce fichier en secrets.yaml et remplir avec tes vraies valeurs.
# secrets.yaml ne doit jamais être commité (déjà dans .gitignore).
# Liste complète : docs/secrets_reference.md
#
# OBLIGATOIRE avant de flasher : remplacer wifi_ssid, wifi_password, eedomus_host,
# eedomus_api_user, eedomus_api_secret et les eedomus_periph_* (IDs réels).
# Garder "IP_OU_HOST_EEDOMUS" ou "TON_API_USER" = pas de connexion eedomus (erreur parse url dans les logs).

wifi_ssid: "TON_SSID_WIFI"
wifi_password: "TON_MOT_DE_PASSE_WIFI"
ap_ssid: "MSPA-RECOVERY"
ap_password: "MOT_DE_PASSE_AP_SECOURS"

# eedomus : mettre "false" sur un site SANS eedomus (évite les crashs)
eedomus_enabled: "true"
eedomus_host: "IP_OU_HOST_EEDOMUS"
eedomus_api_user: "TON_API_USER"
eedomus_api_secret: "TON_API_SECRET"

# IDs des périphériques Eedomus (créer les périphs dans Eedomus, puis mettre leurs ID ici)
# Ne pas committer les vraies valeurs. Exemple : 0 à remplacer par l’ID réel.
eedomus_periph_filtration: 0
eedomus_periph_chauffage: 0
eedomus_periph_bulles: 0
eedomus_periph_uvc: 0
eedomus_periph_verrouillage: 0
eedomus_periph_consigne_temp: 0
eedomus_periph_temp_eau: 0

# Optionnel : IP fixe (décommenter et ajouter manual_ip dans mspa-controller.yaml si besoin)
# static_ip: "192.168.1.226"
# gateway: "192.168.1.1"
# subnet: "255.255.255.0"

# URLs pour actionneurs HTTP eedomus (copier la valeur dans chaque état ; remplacer <IP_ESP> par ton IP)
# eedomus_url_filtration_off: "http://<IP_ESP>/switch/filtration/turn_off"
# eedomus_url_filtration_on: "http://<IP_ESP>/switch/filtration/turn_on"
# eedomus_url_chauffage_off: "http://<IP_ESP>/switch/chauffage/turn_off"
# eedomus_url_chauffage_on: "http://<IP_ESP>/switch/chauffage/turn_on"
# eedomus_url_uvc_off: "http://<IP_ESP>/switch/uvc/turn_off"
# eedomus_url_uvc_on: "http://<IP_ESP>/switch/uvc/turn_on"
# eedomus_url_verrouillage_off: "http://<IP_ESP>/switch/verrouillage_clavier/turn_off"
# eedomus_url_verrouillage_on: "http://<IP_ESP>/switch/verrouillage_clavier/turn_on"
# eedomus_url_bulles_arret: "http://<IP_ESP>/select/mode_bulles/set?option=Arret"
# eedomus_url_bulles_niveau1: "http://<IP_ESP>/select/mode_bulles/set?option=Niveau1"
# eedomus_url_bulles_niveau2: "http://<IP_ESP>/select/mode_bulles/set?option=Niveau2"
# eedomus_url_bulles_niveau3: "http://<IP_ESP>/select/mode_bulles/set?option=Niveau3"
# eedomus_url_consigne_25: "http://<IP_ESP>/number/temperature_consigne/set?value=25"
# eedomus_url_consigne_30: "http://<IP_ESP>/number/temperature_consigne/set?value=30"
# eedomus_url_consigne_35: "http://<IP_ESP>/number/temperature_consigne/set?value=35"
# eedomus_url_consigne_36: "http://<IP_ESP>/number/temperature_consigne/set?value=36"
# eedomus_url_consigne_37: "http://<IP_ESP>/number/temperature_consigne/set?value=37"
# eedomus_url_consigne_38: "http://<IP_ESP>/number/temperature_consigne/set?value=38"
